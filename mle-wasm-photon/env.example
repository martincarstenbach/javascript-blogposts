# shellcheck shell=bash
# Variables are consumed by the script that sources this file.
# shellcheck disable=SC2034
# Copy to .env and replace the placeholders locally. Do not commit credentials.
ORACLE_USERNAME='your_db_account'
ORACLE_PASSWORD='your_db_account_password'
# Use an Oracle Net connection string or a service alias from tnsnames.ora.
ORACLE_CONNECTIONSTRING='//localhost:1521/freepdb1'

# For an mTLS connection using a wallet, for connections to Autonomous Database-Serverless
# Follow these steps
# 1. Download and extract the database wallet from OCI’s Database connection dialog.
# 2. Set TNS_ADMIN to the extracted directory containing tnsnames.ora and sqlnet.ora.
# 3. Ensure WALLET_LOCATION in sqlnet.ora points to that directory. You _MUST_ edit sqlnet.ora and replace the path
# 4. Allow network access from your machine to the database endpoint, normally port 1522 for mTLS. Oracle client setup
# Uncomment and customize these settings for mTLS:
# export TNS_ADMIN='/absolute/path/to/Wallet_MYADB'
# ORACLE_CONNECTIONSTRING='myadb_low'
# See also https://docs.oracle.com/en/cloud/paas/autonomous-database/serverless/adbsb/connect-prepare-oci-wallets.html
